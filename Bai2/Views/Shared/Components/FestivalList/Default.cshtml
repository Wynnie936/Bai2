@model IReadOnlyList<Bai2.Models.Festival>

<h3>Danh sách lễ hội</h3>

@if (Model.Count == 0)
{
    <p>Chưa có lễ hội nào.</p>
}
else
{
    <div class="row">
    @foreach (var festival in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@festival.Name</h5>
                    <p class="card-text"><strong>Ngày:</strong> @festival.Date.ToString("dd/MM/yyyy")</p>
                    <p class="card-text"><strong>Địa điểm:</strong> @festival.Location</p>
                </div>
            </div>
        </div>
    }
    </div>
}
